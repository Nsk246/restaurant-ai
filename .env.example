# ---- core ----
DATABASE_URL=postgresql://operator:operator@127.0.0.1:5432/operator
REDIS_URL=redis://127.0.0.1:6379/0
APP_ENV=dev
LOG_LEVEL=info

# Public base URL Twilio reaches. Use an ngrok tunnel in dev.
PUBLIC_BASE_URL=https://your-tunnel.ngrok.app

# ---- telephony ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Validate every inbound webhook signature. Never turn this off in prod.
TWILIO_VALIDATE_SIGNATURE=true
# Twilio edge nearest your compute. Cuts media round trip.
TWILIO_EDGE=ashburn

# ---- realtime speech model ----
# Provider is pluggable so M1 can be benchmarked before we commit.
REALTIME_PROVIDER=gemini
GEMINI_API_KEY=
# Gemini 2.0 Flash was retired March 2026. Model ids churn; check
# https://ai.google.dev/gemini-api/docs/models if a session fails to open.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
# minimal | low | medium | high. Lower means faster first audio.
GEMINI_THINKING_LEVEL=minimal
# Silence before the model treats the caller's turn as finished. Added to
# every turn, so it is usually the single largest term in perceived latency.
# Below ~350ms it starts interrupting people who pause mid-sentence.
GEMINI_END_OF_SPEECH_MS=500
GEMINI_VOICE=Aoede
GEMINI_REGION=us-central1

# ---- payments (links only, never card numbers over voice) ----
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- guardrails ----
# Abort a tool call that exceeds this and speak a filler line instead.
TOOL_TIMEOUT_MS=1200
# Escalate to a human after this many failed comprehension attempts.
MAX_CLARIFY_ATTEMPTS=2
# Hard cap on call duration as a runaway-cost backstop.
MAX_CALL_SECONDS=600
