{
  "name": "Restaurant AI Operator",

  // Deliberately a single prebuilt image with no features and no compose.
  // The previous version used a compose stack plus three features, which
  // meant Codespaces had to build a container from a base image on every
  // create. That is a lot of surface for a project that needs one Postgres
  // and one Redis. Python is already in this image; Postgres and Redis are
  // apt-installed by setup.sh in seconds.
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",

  "forwardPorts": [8000, 5173],
  "portsAttributes": {
    "8000": { "label": "voice api", "visibility": "public" },
    "5173": { "label": "portal", "visibility": "public" }
  },

  "postCreateCommand": "bash .devcontainer/setup.sh",
  "postStartCommand": "bash .devcontainer/start.sh",

  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
